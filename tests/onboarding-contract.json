{
  "contract": "itsm-setup-onboarding",
  "contract_version": 1,
  "modes": [
    "dev",
    "prod"
  ],
  "states": [
    "unclaimed",
    "claimed",
    "ai_configured",
    "ai_deferred",
    "storage_ready",
    "owner_ready",
    "configuring",
    "verifying",
    "complete"
  ],
  "initial_state": "unclaimed",
  "terminal_state": "complete",
  "transitions": [
    {
      "from": "unclaimed",
      "to": "claimed",
      "trigger": "operator presents the one-time claim credential",
      "actor": "claim",
      "via": "claim",
      "recovery": false
    },
    {
      "from": "claimed",
      "to": "ai_configured",
      "trigger": "provider endpoint, model and tool call verified before any database exists",
      "actor": "session",
      "via": "configure_ai",
      "recovery": false
    },
    {
      "from": "claimed",
      "to": "ai_deferred",
      "trigger": "operator chooses manual continuation after an AI failure (D1)",
      "actor": "session",
      "via": "defer_ai",
      "recovery": false
    },
    {
      "from": "ai_configured",
      "to": "storage_ready",
      "trigger": "database reachable, migrated and prepared",
      "actor": "session",
      "via": "apply_storage",
      "recovery": false
    },
    {
      "from": "ai_deferred",
      "to": "storage_ready",
      "trigger": "database reachable, migrated and prepared with AI still pending",
      "actor": "session",
      "via": "apply_storage",
      "recovery": false
    },
    {
      "from": "storage_ready",
      "to": "owner_ready",
      "trigger": "first superadmin bootstrapped through identity.service",
      "actor": "session",
      "via": "bootstrap_owner",
      "recovery": false
    },
    {
      "from": "owner_ready",
      "to": "configuring",
      "trigger": "operator starts the assisted configuration pass",
      "actor": "session",
      "via": "start_configuration",
      "recovery": false
    },
    {
      "from": "configuring",
      "to": "verifying",
      "trigger": "every required check for the mode reports its result",
      "actor": "session",
      "via": "verify",
      "recovery": false
    },
    {
      "from": "verifying",
      "to": "complete",
      "trigger": "required results verified and bootstrap mutation disabled",
      "actor": "session",
      "via": "complete",
      "recovery": false
    },
    {
      "from": "complete",
      "to": "configuring",
      "trigger": "operator explicitly reopens configuration from the local CLI",
      "actor": "operator_cli",
      "via": "recover",
      "recovery": true
    }
  ],
  "operations": [
    {
      "id": "status",
      "method": "GET",
      "path": "/api/setup/v1/status",
      "required_states": [
        "unclaimed",
        "claimed",
        "ai_configured",
        "ai_deferred",
        "storage_ready",
        "owner_ready",
        "configuring",
        "verifying",
        "complete"
      ],
      "auth": "anonymous",
      "read_only": true,
      "idempotent": true,
      "returns": [
        "state",
        "mode",
        "release_mode",
        "setup_enabled",
        "claim_available",
        "backend",
        "version",
        "instance_id"
      ]
    },
    {
      "id": "claim",
      "method": "POST",
      "path": "/api/setup/v1/claim",
      "required_states": [
        "unclaimed"
      ],
      "to_state": "claimed",
      "auth": "claim",
      "read_only": false,
      "idempotent": false,
      "origin_check": true,
      "csrf": false
    },
    {
      "id": "session",
      "method": "GET",
      "path": "/api/setup/v1/session",
      "required_states": [
        "claimed",
        "ai_configured",
        "ai_deferred",
        "storage_ready",
        "owner_ready",
        "configuring",
        "verifying"
      ],
      "auth": "session",
      "read_only": true,
      "idempotent": true,
      "returns": [
        "state",
        "mode",
        "release_mode",
        "checks"
      ]
    },
    {
      "id": "session_logout",
      "method": "POST",
      "path": "/api/setup/v1/session/logout",
      "required_states": [
        "claimed",
        "ai_configured",
        "ai_deferred",
        "storage_ready",
        "owner_ready",
        "configuring",
        "verifying"
      ],
      "auth": "session",
      "idempotent": true,
      "origin_check": true,
      "csrf": true,
      "returns": [
        "status"
      ],
      "source": "backend/itsm/setup/api.py:392-402"
    },
    {
      "id": "configure_ai",
      "method": "POST",
      "path": "/api/setup/v1/ai",
      "required_states": [
        "claimed",
        "ai_deferred"
      ],
