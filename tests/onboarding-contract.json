  "known_gaps": [
    {
      "id": "agent_credentials_env_only",
      "statement": "Agent credentials are environment-only. The wizard AI key becomes the first owner's personal AgentProvider at hand-off; the agent configuration section stays pending unless the deployment supplies a provider credential in the environment (for example OPENAI_API_KEY), so ai_explicit never turns green from the wizard key alone.",
      "consequence": "A wizard-only installation keeps ai_explicit required, blocking completion until an operator credential exists.",
      "source": "backend/itsm/setup/configuration.py:_agent_current; backend/itsm/agents/credentials.py"
    },
    {
      "id": "no_organization_table",
      "statement": "There is no organization table: installation branding is written through the appearance section as a built-in or custom preset (appearance_decided), never as an organization row.",
      "consequence": "Any expectation of a persisted organization name or slug has no storage; appearance is the only branding surface.",
      "source": "backend/itsm/appearance/service.py; backend/itsm/setup/configuration.py:_applier_appearance"
    },
    {
      "id": "no_backup_policy_writer",
      "statement": "Nothing in the wizard writes a backup policy. Production reads an existing policy through backup_status_path, and an installation that has none must postpone nothing and instead record accept_risk for the backup_policy_declared item, which is stored as risk, never passed.",
