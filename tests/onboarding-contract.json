        "storage_ready",
        "owner_ready",
        "configuring",
        "verifying"
      ],
      "auth": "session",
      "idempotent": true,
      "origin_check": true,
      "csrf": true,
      "returns": [
        "status"
      ],
      "source": "backend/itsm/setup/api.py:392-402"
    },
    {
