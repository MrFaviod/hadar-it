# Hadar IT — Docker Compose configuration template (no real credentials).
# Local evaluation only; this alpha is not production-ready.
# Copy: cp .env.example .env && chmod 600 .env
# Fill ITSM_SELINUX_LEVEL before using it. ITSM_DEV_ADMIN_PASSWORD is optional:
# leave it empty to create the first owner in the setup wizard.
# Validate: docker compose --env-file .env config --quiet
# Build: docker compose --env-file .env build backend frontend
# Start: docker compose --env-file .env up -d --wait --wait-timeout 180
# Stop (preserves volumes): docker compose --env-file .env down
# Do not use --env-file /dev/null with this file: that selects shell-only config.
# Shell exports override values here. Use a fresh shell to avoid old settings.
# The backend itself reads process environment, not dotenv files.

# Local development with fictional data; selects the matching storage overlay.
RELEASE_MODE=dev
COMPOSE_PROJECT_NAME=hadar-local
COMPOSE_FILE=compose.yaml:deploy/compose.dev.yaml
ITSM_FRONTEND_PORT=18080
ITSM_API_PORT=18000
ITSM_AUTH_ORIGIN=http://127.0.0.1:18080
# Keep false unless a proxy in front of the frontend appends X-Forwarded-For.
ITSM_TRUSTED_PROXY=false

# Required: reserve a distinct MCS level with the host operator, even without
# SELinux. Example format only: s0:c500,c501. Do not reuse another stack's level.
ITSM_SELINUX_LEVEL=
# Optional, headless only: a new development administrator password, 12–128
# characters. Leave empty to start ownerless and create the first owner in the
# setup wizard (INSTALL.md section 4). When set, preparation seeds dev.admin and
# the wizard stays disabled.
# Use single quotes around values containing $ or #. Never reuse a real password.
# Changing this value does not change an account that already exists.
ITSM_DEV_ADMIN_PASSWORD=

# Optional: absolute path to a JSON file of installation-owned settings (a 0600
# file inside a 0700 directory, never a symlink). Precedence: process
# environment > installation file > documented default; an environment variable
# that is present wins even when explicitly empty. Application processes read
# it, so a Compose deployment must mount the file and pass this variable to each
# service. Never commit the file.
#ITSM_INSTALLATION_CONFIG=/etc/hadar-it/installation.json

# Optional: exact browser origins allowed to drive the setup wizard, comma
# separated. The setup service uses it ahead of ITSM_AUTH_ORIGIN.
# deploy/compose.prod.yaml currently derives it from ITSM_AUTH_ORIGIN, so
# override it in the service environment only when the wizard origin differs.
#ITSM_SETUP_ALLOWED_ORIGINS=https://hadar.example.com

ITSM_LOG_LEVEL=INFO

# Reports and background tasks. The dev overlay fixes task storage to SQLite;
# keep the worker running for reports. Match these URLs if you change the port.
ITSM_REPORT_BASE_URL=http://127.0.0.1:18080
ITSM_REPORT_RETENTION_DAYS=7
ITSM_REPORT_MAX_ASSETS=1000
ITSM_TASK_RETRIES=2
ITSM_TASK_RETRY_DELAY_SECONDS=1
ITSM_ATTACHMENT_MAX_BYTES=10485760

# Optional AI. Empty model/credentials leave inference unconfigured.
# Set a provider:model supported by the backend and its matching provider key.
ITSM_AGENT_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ITSM_AGENT_OPENAI_BASE_URL=
ITSM_AGENT_MAX_STEPS=8
ITSM_AGENT_MAX_HISTORY_MESSAGES=20
ITSM_AGENT_MAX_OUTPUT_TOKENS=1024
ITSM_AGENT_RUN_TIMEOUT_SECONDS=180
# External Fernet key for encrypted provider credentials; retain separately from
# SQL backups. Do not replace an existing installation key to rotate credentials.
ITSM_AI_CREDENTIAL_KEY=
# JSON map of credential reference -> permitted destination URLs. No secret values.
ITSM_AI_SECRET_DESTINATIONS='{}'
# Ordinary-user inference also requires a separately configured host-side broker.
ITSM_AI_BROKER_URL=
ITSM_AI_BROKER_TOKEN=
ITSM_HERMES_INSPECTOR_URL=
ITSM_HERMES_INSPECTOR_TOKEN=
ITSM_SYSTEM_EXECUTOR_URL=
ITSM_SYSTEM_EXECUTOR_TOKEN=
ITSM_EXTENSION_VALIDATOR_URL=
ITSM_EXTENSION_VALIDATOR_TOKEN=

# Optional live monitoring: set an external URL, or enable the monitoring profile
# and use http://prometheus:9090. Blank input falls back to the Compose default;
# it does not start Prometheus or supply monitoring credentials.
ITSM_PROMETHEUS_URL=
ITSM_PROMETHEUS_TOKEN=
ITSM_MONITORING_PUBLIC_URL=http://127.0.0.1:18080
ITSM_MONITORING_DISCOVERY_TOKEN=
ITSM_MONITORING_INGEST_TOKEN=
ITSM_ALERTMANAGER_URL=
ITSM_ALERTMANAGER_TOKEN=
ITSM_MONITORING_SECRETS='{}'
ITSM_NOTIFICATION_RETENTION_DAYS=90

# Optional Meilisearch: use an external URL or enable the search profile and
# set http://meilisearch:7700 plus a new master key. SQL search works without it.
ITSM_MEILISEARCH_URL=
ITSM_MEILISEARCH_API_KEY=
ITSM_MEILI_MASTER_KEY=
ITSM_SEARCH_INDEX_NAME=itsm_entities

# Production is a different installation, not a change to this dev data volume.
# See docs/release-modes-deployment.md before choosing prod or demo.
# For prod: select deploy/compose.prod.yaml, use a distinct project name and MCS
# level, provide an explicit database URL and exact HTTPS browser origin.
# The prod overlay enforces Secure cookies and requires explicit owner bootstrap.
# ITSM_DATABASE_URL=
# ITSM_POSTGRES_PASSWORD=
# ITSM_OPS_RETENTION_KEEP=7
# ITSM_OPS_BACKUP_INTERVAL_SECONDS=86400
# Optional tls profile accepts PEM content, not host filesystem paths:
# ITSM_TLS_CERTIFICATE=
# ITSM_TLS_CERTIFICATE_KEY=
# ITSM_TLS_BIND=127.0.0.1
# ITSM_TLS_PORT=18443
